# ═══════════════════════════════════════════════════════
#  Highway Tolling System — .gitignore
# ═══════════════════════════════════════════════════════

# ── Secrets & Environment Variables ─────────────────────
.env
.env.*
*.env
!.env.example
application-secrets.properties
secrets.properties
credentials.json

# ── Maven / Java Build Output ────────────────────────────
target/
iot-simulator/target/
*.jar
*.war
*.nar
*.ear
*.class

# ── Compressed Archives ──────────────────────────────────
*.zip
*.tar.gz
*.rar

# ── Maven Wrapper Cache ──────────────────────────────────
.mvn/wrapper/maven-wrapper.jar

# ── Frontend — Main Project ──────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
frontend/*.local

# ── Frontend — IoT Simulator ─────────────────────────────
iot-simulator/frontend/node_modules/
iot-simulator/frontend/dist/

# ── IoT Simulator Runtime Data ───────────────────────────
# Database files and backups are explicitly allowed to be tracked
!*.sql
!*.db
!iot-simulator/data/*.db

# Vehicle state snapshot (auto-regenerated on each run)
iot-simulator/data/vehicle-state.json
# Old offline GPS data file (no longer used)
iot-simulator/offline-gps-data.json
iot-simulator/Report.txt

# ── Node.js Debug Logs ───────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Application Logs ─────────────────────────────────────
*.log
*.log.*
logs/

# ── Temporary / Swap Files ───────────────────────────────
*.tmp
*.temp
*.swp
*.swo
*~
*.bak
*.backup
*.old

# ── OS Generated Files ───────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
[Tt]humbs.db
ehthumbs.db
.AppleDouble
.LSOverride

# ── IDE — IntelliJ IDEA ──────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
out/

# ── IDE — Eclipse / VS Code / NetBeans ──────────────────
.project
.classpath
.settings/
.metadata/
bin/
.vscode/
*.code-workspace
nbproject/
nbbuild/
nbdist/
.nb-gradle/

# ── Build Caching / Coverage ─────────────────────────────
.gradle/
build/
coverage/
*.coverage

# ── AI / Agent Artifacts ─────────────────────────────────
.gemini/
brain/
